{
  "name": "@tradersamwise/jiten-reader-react-native",
  "version": "0.1.0",
  "description": "Reusable Jiten-compatible Japanese ebook reader controller, lookup, furigana, and reader view components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js",
      "default": "./dist/backend.js"
    },
    "./furigana": {
      "types": "./dist/furigana.d.ts",
      "import": "./dist/furigana.js",
      "default": "./dist/furigana.js"
    },
    "./furigana-types": {
      "types": "./dist/furigana-types.d.ts",
      "import": "./dist/furigana-types.js",
      "default": "./dist/furigana-types.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./reader-view": {
      "types": "./dist/reader-view.d.ts",
      "react-native": "./dist/reader-view.native.js",
      "import": "./dist/reader-view.web.js",
      "default": "./dist/reader-view.web.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraderSamwise/jiten.git",
    "directory": "packages/japanese-reader"
  },
  "bugs": {
    "url": "https://github.com/TraderSamwise/jiten/issues"
  },
  "homepage": "https://github.com/TraderSamwise/jiten/tree/master/packages/japanese-reader#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx build.ts && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tradersamwise/jiten-reader-core": "0.1.0",
    "@tradersamwise/jiten-reader-webview": "0.1.0",
    "wanakana": "^5.3.1"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "tsx": "^4.0.0",
    "typescript": "~5.9.2"
  }
}
