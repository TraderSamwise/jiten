{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@tradersamwise/japanese-reader-core": ["../japanese-reader-core/dist/index.d.ts"],
      "@tradersamwise/reader-webview": ["../reader-webview/dist/index.d.ts"],
      "@tradersamwise/reader-webview/bundle": ["../reader-webview/dist/bundle.d.ts"]
    },
    "rootDir": "src",
    "skipLibCheck": true,
    "target": "ES2020",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/reader-view.d.ts"]
}
