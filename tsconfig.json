{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@tradersamwise/jiten-reader-react-native": ["./packages/japanese-reader/src/index.ts"],
      "@tradersamwise/jiten-reader-react-native/*": ["./packages/japanese-reader/src/*"],
      "@tradersamwise/jiten-reader-webview/*": ["./packages/reader-webview/*"],
      "@tradersamwise/jiten-reader-core": ["./packages/japanese-reader-core/src/index.ts"],
      "@tradersamwise/jiten-reader-core/*": ["./packages/japanese-reader-core/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "environment.d.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
