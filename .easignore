# EAS Build ignore file
# When .easignore exists, it completely overrides .gitignore
# We need to copy all .gitignore entries and then use ! to include what we want

# Ignore common development files
.git
.env*.local

# Ignore native projects entirely — EAS regenerates them from app.config.js via
# prebuild (CNG). Uploading a local ios/android makes EAS SKIP prebuild and build
# a STALE native project, so icon/splash/app.config changes silently don't apply.
/ios
/android

# Ignore node_modules (will be installed fresh)
node_modules/

# Ignore expo cache
.expo/
.expo-shared/

# Ignore debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Ignore macOS files
.DS_Store

# Ignore build cache
.cache/
