{
  "installCommand": "rm -rf node_modules/expo-sqlite && yarn install --check-files",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.+/.+)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/proxy/aozora/:path*",
      "destination": "/api/proxy?route=aozora&path=:path*"
    },
    {
      "source": "/proxy/syosetu-api/:path*",
      "destination": "/api/proxy?route=syosetu-api&path=:path*"
    },
    {
      "source": "/proxy/syosetu/:path*",
      "destination": "/api/proxy?route=syosetu&path=:path*"
    },
    {
      "source": "/((?!_next|assets|proxy|api).*)",
      "destination": "/index.html"
    }
  ]
}
