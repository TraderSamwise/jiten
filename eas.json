{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "distribution": "store",
      "autoIncrement": false,
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_DICT_MANIFEST_URL": "https://github.com/TraderSamwise/jiten-data/releases/download/v1/dict-manifest.json"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "image": "latest"
      },
      "distribution": "store",
      "autoIncrement": false,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DICT_MANIFEST_URL": "https://github.com/TraderSamwise/jiten-data/releases/download/v1/dict-manifest.json"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
