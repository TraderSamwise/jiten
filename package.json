    "@types/encoding-japanese": "^2.2.1",
    "@types/react": "~19.1.0",
    "@types/wanakana": "^5.3.0",
    "@vercel/node": "^5.6.11",
    "@vitest/coverage-v8": "4.0.18",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "eas-cli": "^18.5.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "node-wordnet": "^0.1.12",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18",
    "wordnet-db": "^3.1.14"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --quiet",
    "*.{json,md,css}": "prettier --write"
