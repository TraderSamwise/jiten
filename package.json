    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3",
    "ts-fsrs": "^5.2.3",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.11"
