    "lucide-react-native": "^0.563.0",
    "nativewind": "^4",
    "optics-ts": "^2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
