{
  "name": "jiten",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:db": "npx tsx scripts/build-dictionary.ts",
    "build:extended": "npx tsx scripts/build-extended-data.ts",
    "migrate:dict": "npx tsx scripts/migrate-dict.ts",
    "build:jlpt": "npx tsx scripts/build-jlpt-list.ts",
    "build:reader": "npx tsx packages/reader-webview/build.ts",
    "build:preprocessing": "npx tsx lib/share-extension/build-preprocessing.ts",
    "prestart": "yarn build:reader && yarn build:preprocessing",
    "prebuild": "yarn build:reader && yarn build:preprocessing",
    "serve:dev": "npx tsx scripts/serve-dev.ts",
    "publish:dict": "./scripts/publish-dict.sh",
    "check:dict": "./scripts/check-dict-version.sh",
    "test": "yarn build:reader && vitest run",
    "test:coverage": "yarn build:reader && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:env": "node scripts/check-release-env.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "patch-package",
    "prepare": "husky",
    "build": "eas-release build testflight",
    "build:testflight": "eas-release build testflight",
    "build:production": "eas-release build production",
    "update": "eas-release update testflight",
    "update:production": "eas-release update production",
    "version:current": "eas-release current",
    "version:bump-build": "eas-release bump-build",
    "version:bump-ota": "eas-release bump-ota",
    "version:rollback": "eas-release rollback",
    "version:set": "eas-release set",
    "version:sync": "eas-release sync"
  },
  "dependencies": {
